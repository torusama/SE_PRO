NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/cemetery_db
DB_MIGRATIONS_ENABLED=true

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# Gmail HTTP API (OAuth 2.0). Use an OAuth client of type "Desktop app".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=your-account@gmail.com
GMAIL_API_TIMEOUT_MS=15000

SMS_API_URL=
SMS_API_KEY=

# AI provider routing. Keep rotation enabled so consecutive conversations do
# not concentrate traffic on one provider. Each provider can accept a
# comma-separated key pool; put the intended 10 NVIDIA NIM keys here.
AI_LLM_ROTATE_PROVIDERS=true
AI_LLM_TOTAL_TIMEOUT_MS=12000
AI_LLM_PROVIDER_TIMEOUT_MS=5000

OPENAI_API_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_API_KEYS=
OPENAI_TIMEOUT_MS=5000
OPENAI_TOTAL_TIMEOUT_MS=10000
OPENAI_MAX_ATTEMPTS=10

OPENAI_SECONDARY_API_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_SECONDARY_MODEL=openai/gpt-oss-120b
OPENAI_SECONDARY_API_KEYS=
OPENAI_SECONDARY_TIMEOUT_MS=5000
OPENAI_SECONDARY_TOTAL_TIMEOUT_MS=10000
OPENAI_SECONDARY_MAX_ATTEMPTS=10

NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_KEYS=
NVIDIA_TIMEOUT_MS=5000
NVIDIA_TOTAL_TIMEOUT_MS=10000
NVIDIA_MAX_ATTEMPTS=10

# Semantic RAG embeddings. By default this reuses NVIDIA_API_KEYS.
AI_EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1
AI_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_TIMEOUT_MS=1500
AI_EMBEDDING_TOTAL_TIMEOUT_MS=2500
AI_EMBEDDING_MAX_ATTEMPTS=2
AI_RAG_BACKFILL_ON_STARTUP=true
AI_RAG_BACKFILL_BATCH_SIZE=5
