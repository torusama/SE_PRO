NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/cemetery_db
DB_MIGRATIONS_ENABLED=true

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173

# Gmail HTTP API (OAuth 2.0). Use an OAuth client of type "Desktop app".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=your-account@gmail.com
GMAIL_API_TIMEOUT_MS=15000

SMS_API_URL=
SMS_API_KEY=

# AI provider routing. Groq GPT-OSS 20B starts first; Groq GPT-OSS 120B and
# Groq Qwen 3.8 27B join as staggered hedges when an earlier route is slow.
AI_LLM_WRITES_CONVERSATIONAL_TURNS=true
AI_LLM_ROTATE_PROVIDERS=false
AI_LLM_HEDGE_PROVIDERS=true
AI_LLM_HEDGE_DELAY_MS=900
AI_LLM_MAX_KEY_ROUNDS=2
AI_LLM_TOTAL_TIMEOUT_MS=12000
AI_LLM_MAX_TOTAL_TIMEOUT_MS=12000
AI_LLM_PROVIDER_TIMEOUT_MS=6000

# Three independent Groq model/key pools. Each *_API_KEYS value accepts a
# JSON array, comma-separated keys, or the legacy multiline { ... } format.
GROQ_20B_API_KEY=
GROQ_20B_API_KEYS="{
  gsk_replace_with_first_20b_key
  gsk_replace_with_second_20b_key
}"
GROQ_20B_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_20B_MODEL=openai/gpt-oss-20b
GROQ_20B_TIMEOUT_MS=5000
GROQ_20B_TOTAL_TIMEOUT_MS=8000
GROQ_20B_MAX_ATTEMPTS=10
GROQ_20B_KEY_COOLDOWN_MS=60000
GROQ_20B_INVALID_KEY_COOLDOWN_MS=600000

GROQ_120B_API_KEY=
GROQ_120B_API_KEYS="{
  gsk_replace_with_first_120b_key
  gsk_replace_with_second_120b_key
}"
GROQ_120B_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_120B_MODEL=openai/gpt-oss-120b
GROQ_120B_TIMEOUT_MS=6000
GROQ_120B_TOTAL_TIMEOUT_MS=9000
GROQ_120B_MAX_ATTEMPTS=10
GROQ_120B_KEY_COOLDOWN_MS=60000
GROQ_120B_INVALID_KEY_COOLDOWN_MS=600000

GROQ_QWEN_38_API_KEY=
GROQ_QWEN_38_API_KEYS="{
  gsk_replace_with_first_qwen_key
  gsk_replace_with_second_qwen_key
}"
GROQ_QWEN_38_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_QWEN_38_MODEL=qwen/qwen3.8-27b
GROQ_QWEN_38_TIMEOUT_MS=6000
GROQ_QWEN_38_TOTAL_TIMEOUT_MS=9000
GROQ_QWEN_38_MAX_ATTEMPTS=10
GROQ_QWEN_38_KEY_COOLDOWN_MS=60000
GROQ_QWEN_38_INVALID_KEY_COOLDOWN_MS=600000

OPENAI_API_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=openai/gpt-oss-20b
OPENAI_API_KEYS=
OPENAI_TIMEOUT_MS=16000
OPENAI_TOTAL_TIMEOUT_MS=20000
OPENAI_MAX_ATTEMPTS=10

OPENAI_SECONDARY_API_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_SECONDARY_MODEL=openai/gpt-oss-120b
OPENAI_SECONDARY_API_KEYS=
OPENAI_SECONDARY_TIMEOUT_MS=16000
OPENAI_SECONDARY_TOTAL_TIMEOUT_MS=24000
OPENAI_SECONDARY_MAX_ATTEMPTS=10

# Dedicated content AI pool for memorial email drafts and plot introductions.
# It never borrows chat, comparison, agent or embedding keys. EMAIL_AI_API_KEYS
# accepts the same comma-separated, JSON-array, or multiline { ... } format.
EMAIL_AI_API_KEY=
EMAIL_AI_API_KEYS=
EMAIL_AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
EMAIL_AI_MODEL=openai/gpt-oss-20b
EMAIL_AI_TIMEOUT_MS=10000
EMAIL_AI_TOTAL_TIMEOUT_MS=22000
EMAIL_AI_MAX_ATTEMPTS=3
EMAIL_AI_KEY_COOLDOWN_MS=60000
EMAIL_AI_INVALID_KEY_COOLDOWN_MS=600000

# Dedicated comparison analysis pool (does not share chat rotation)
COMPARISON_AI_API_KEY=
COMPARISON_AI_API_KEYS=
COMPARISON_AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
COMPARISON_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
COMPARISON_AI_TIMEOUT_MS=6500
COMPARISON_AI_TOTAL_TIMEOUT_MS=14000
COMPARISON_AI_MAX_ATTEMPTS=10
COMPARISON_AI_KEY_COOLDOWN_MS=60000
COMPARISON_AI_INVALID_KEY_COOLDOWN_MS=600000

# Dedicated deep comparison pool. Falls back to COMPARISON_AI_*.
DECISION_AI_API_KEY=
DECISION_AI_API_KEYS=
DECISION_AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
DECISION_AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
DECISION_AI_TIMEOUT_MS=12000
DECISION_AI_TOTAL_TIMEOUT_MS=24000
DECISION_AI_MAX_ATTEMPTS=10
DECISION_AI_KEY_COOLDOWN_MS=60000
DECISION_AI_INVALID_KEY_COOLDOWN_MS=600000

MISTRAL_AGENT_API_KEY=
MISTRAL_AGENT_API_KEYS=
MISTRAL_AGENT_API_BASE_URL=https://integrate.api.nvidia.com/v1
MISTRAL_AGENT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
MISTRAL_AGENT_TIMEOUT_MS=18000
MISTRAL_AGENT_TOTAL_TIMEOUT_MS=24000
MISTRAL_AGENT_TIMEOUT_MS=2500
MISTRAL_AGENT_TOTAL_TIMEOUT_MS=10000
MISTRAL_AGENT_MAX_ATTEMPTS=10
MISTRAL_AGENT_KEY_COOLDOWN_MS=60000
MISTRAL_AGENT_INVALID_KEY_COOLDOWN_MS=600000
MISTRAL_AGENT_MAX_TOKENS=2048
MISTRAL_AGENT_TEMPERATURE=0.2

# Semantic RAG embeddings powered by Llama Nemotron Embed. This pool is never
# used by the Mistral agent.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_API_KEYS=
AI_EMBEDDING_API_BASE_URL=https://integrate.api.nvidia.com/v1
AI_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_TIMEOUT_MS=1500
AI_EMBEDDING_TOTAL_TIMEOUT_MS=2500
AI_EMBEDDING_MAX_ATTEMPTS=2
AI_RAG_MAX_COSINE_DISTANCE=0.72
AI_RAG_BACKFILL_ON_STARTUP=true
AI_RAG_BACKFILL_BATCH_SIZE=5
AI_RAG_BACKFILL_MAX_ENTRIES=25
