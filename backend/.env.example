NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:password@localhost:5432/cemetery_db

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gửi email OTP (xác thực Gmail chủ tài khoản + email người liên hệ khẩn cấp) ---
# Cách lấy nhanh cho Gmail:
# 1. Bật xác minh 2 bước cho tài khoản Gmail: https://myaccount.google.com/security
# 2. Tạo "Mật khẩu ứng dụng" (App Password): https://myaccount.google.com/apppasswords
#    -> chọn app "Mail", thiết bị "Other", đặt tên tuỳ ý -> Google cho ra 16 ký tự, dán vào SMTP_PASS bên dưới.
# 3. SMTP_USER = chính địa chỉ Gmail bạn dùng để tạo App Password ở trên.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Gửi SMS OTP (xác thực số điện thoại) ---
# Chưa cấu hình -> ở development, mã OTP được in ra log server + trả kèm trong
# response API (KHÔNG dùng được ở production, sẽ báo lỗi rõ ràng thay vì im lặng).
# Điền URL + API key của nhà cung cấp SMS bạn chọn (eSMS, SpeedSMS, Twilio...),
# đổi định dạng payload trong sms.service.ts cho khớp API thật của họ nếu cần.
SMS_API_URL=
SMS_API_KEY=

# Nếu bạn điền SMS_API_URL + SMS_API_KEY trong .env → gửi SMS thật.
# Nếu chưa điền (mặc định) → hệ thống không giả vờ gửi thành công — chỉ ở môi trường dev, mã OTP được in ra log server và hiện thẳng trên giao diện (khung vàng "[DEV] mã OTP test: xxxxxx") để bạn test được toàn bộ luồng mà chưa cần trả tiền SMS. Ở production, nếu chưa cấu hình sẽ báo lỗi rõ ràng, không có "cửa sau".
